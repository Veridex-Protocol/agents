{
  "name": "@veridex/agents",
  "version": "0.1.0",
  "description": "Veridex Agent Fabric — TypeScript-first agent runtime with native payments, policy, identity, and trust",
  "license": "MIT",
  "author": "Veridex Team",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.39.0",
    "openai": ">=4.70.0",
    "@veridex/sdk": ">=1.0.1",
    "@veridex/agentic-payments": ">=2.0.4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@veridex/sdk": {
      "optional": true
    },
    "@veridex/agentic-payments": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/node": "^25.5.2",
    "@veridex/agentic-payments": "*",
    "openai": "^4.70.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "veridex",
    "agent",
    "framework",
    "runtime",
    "ai",
    "llm",
    "typescript",
    "payments",
    "policy",
    "trust",
    "openai",
    "anthropic",
    "claude"
  ]
}
